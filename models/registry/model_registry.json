    "training_configuration": {
        "hidden_dimension": 64,
        "dropout": 0.3,
        "learning_rate": 0.0005,
        "weight_decay": 0.0005,
        "epochs": 100,
        "early_stopping": true
    },

    "model_selection": {
        "benchmark_phase": "11.1",
        "architecture_selected": "GraphSAGE",
        "reason":
            "GraphSAGE achieved the highest PR-AUC among tested GNN architectures."
