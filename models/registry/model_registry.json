{
    "project": "Graph Fraud AI",

    "production_model": {
        "name": "graphsage_improved",
        "architecture": "GraphSAGE",
        "checkpoint": "models/graphsage_improved.pt",
        "status": "champion"
    },

    "task": {
        "type": "binary_node_classification",
        "problem": "financial_transaction_fraud_detection",
